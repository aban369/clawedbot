# ClawedBot Environment Variables
# Copy this file to .env and fill in your actual values

# ===== EXCHANGE API KEYS =====
# Binance
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_API_SECRET=your_binance_secret_here

# Bybit
BYBIT_API_KEY=your_bybit_api_key_here
BYBIT_API_SECRET=your_bybit_secret_here

# OKX
OKX_API_KEY=your_okx_api_key_here
OKX_API_SECRET=your_okx_secret_here
OKX_PASSPHRASE=your_okx_passphrase_here

# ===== MT5 CREDENTIALS =====
MT5_LOGIN=your_mt5_account_number
MT5_PASSWORD=your_mt5_password
MT5_SERVER=your_mt5_server_name

# ===== TELEGRAM BOT =====
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

# ===== GOOGLE GEMINI AI =====
GEMINI_API_KEY=your_gemini_api_key_here

# ===== TRADINGVIEW WEBHOOK =====
WEBHOOK_SECRET=your_webhook_secret_key
WEBHOOK_PORT=5000

# ===== DATABASE =====
MONGODB_URI=mongodb://localhost:27017/
DATABASE_NAME=clawedbot

# ===== TRADING SETTINGS =====
# Trading mode: paper, live
TRADING_MODE=paper

# Default trading pair
DEFAULT_PAIR=BTC/USDT

# Risk settings
MAX_POSITION_SIZE=1000
RISK_PER_TRADE=0.02
MAX_DAILY_LOSS=0.05

# ===== LOGGING =====
LOG_LEVEL=INFO
LOG_FILE=logs/clawedbot.log

# ===== DASHBOARD =====
DASHBOARD_PORT=8050
DASHBOARD_HOST=0.0.0.0

# ===== ADVANCED SETTINGS =====
# Enable features
ENABLE_ML_PREDICTIONS=true
ENABLE_HAWKES_DETECTION=true
ENABLE_ECONOPHYSICS=true
ENABLE_SENTIMENT_ANALYSIS=false

# Update intervals (seconds)
DATA_UPDATE_INTERVAL=60
SIGNAL_CHECK_INTERVAL=30
RISK_CHECK_INTERVAL=10

# ===== BACKTEST SETTINGS =====
BACKTEST_START_DATE=2024-01-01
BACKTEST_END_DATE=2025-01-01
BACKTEST_INITIAL_CAPITAL=10000
